# WAExpenseSplitLocalAI — config switchboard (committed example, no secrets)
# Copy to .env and edit. CLIs take paths/actions only; all tuning lives here.

# Primary model (quantized E2B). Swap freely, e.g.:
#   gemma4:e2b-it-q4_K_M
MODEL_NAME=gemma4:e2b-it-qat

# Ollama host (default local)
OLLAMA_HOST=http://localhost:11434

# LLM knobs (keep deterministic)
LLM_TEMPERATURE=0
LLM_NUM_CTX=2048
LLM_TIMEOUT_S=90

# Fixed roster override, comma-separated. Empty (default) = members come from the model's payers.
ROOMMATES=

# Data dir for staged artifacts
DATA_DIR=./data
